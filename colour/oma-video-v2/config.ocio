ocio_profile_version: 2.5

environment:
  {}
search_path: ""
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]
name: Oma Colour 1 - Video 2
description: Oma suite linear Rec.709 D65 interchange. Video component encodings; no tone mapping. PQ linear 1 = 100 cd/m2, preserving highlights above 1. HLG uses normalized inverse OETF, without display OOTF. MLT compositing/storage have integer boundaries. Video 2 adds camera formats, ACES spaces and tone-mapped views; every Video 1 transform is unchanged.

roles:
  aces_interchange: ACES2065-1
  cie_xyz_d65_interchange: CIE XYZ D65
  color_picking: sRGB
  color_timing: rec709/rec709
  compositing_log: Log2 Rec.709
  data: Raw
  default: sRGB
  matte_paint: sRGB
  oma_interchange: Linear Rec.709
  scene_linear: Linear Rec.709
  texture_paint: sRGB

file_rules:
  - !<Rule> {name: Default, colorspace: sRGB}

displays:
  sRGB:
    - !<View> {name: Standard, colorspace: sRGB}
    - !<View> {name: Linear diagnostic, colorspace: Linear Rec.709}
  rec709/rec709:
    - !<View> {name: Standard, colorspace: rec709/rec709}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display rec709/rec709}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display rec709/rec709}
  rec709/srgb:
    - !<View> {name: Standard, colorspace: rec709/srgb}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display rec709/srgb}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display rec709/srgb}
  rec709/linear:
    - !<View> {name: Standard, colorspace: rec709/linear}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
  rec709/2.2:
    - !<View> {name: Standard, colorspace: rec709/2.2}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display rec709/2.2}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display rec709/2.2}
  rec709/2.4:
    - !<View> {name: Standard, colorspace: rec709/2.4}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display rec709/2.4}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display rec709/2.4}
  rec709/2.6:
    - !<View> {name: Standard, colorspace: rec709/2.6}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display rec709/2.6}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display rec709/2.6}
  rec709/pq:
    - !<View> {name: Standard, colorspace: rec709/pq}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 hdr, display_colorspace: display rec709/pq}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 hdr, display_colorspace: display rec709/pq}
  rec709/hlg:
    - !<View> {name: Standard, colorspace: rec709/hlg}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
  srgb/rec709:
    - !<View> {name: Standard, colorspace: srgb/rec709}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display srgb/rec709}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display srgb/rec709}
  srgb/srgb:
    - !<View> {name: Standard, colorspace: srgb/srgb}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display srgb/srgb}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display srgb/srgb}
  srgb/linear:
    - !<View> {name: Standard, colorspace: srgb/linear}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
  srgb/2.2:
    - !<View> {name: Standard, colorspace: srgb/2.2}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display srgb/2.2}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display srgb/2.2}
  srgb/2.4:
    - !<View> {name: Standard, colorspace: srgb/2.4}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display srgb/2.4}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display srgb/2.4}
  srgb/2.6:
    - !<View> {name: Standard, colorspace: srgb/2.6}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display srgb/2.6}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display srgb/2.6}
  srgb/pq:
    - !<View> {name: Standard, colorspace: srgb/pq}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 hdr, display_colorspace: display srgb/pq}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 hdr, display_colorspace: display srgb/pq}
  srgb/hlg:
    - !<View> {name: Standard, colorspace: srgb/hlg}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
  rec2020/rec709:
    - !<View> {name: Standard, colorspace: rec2020/rec709}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr-wide, display_colorspace: display rec2020/rec709}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr-wide, display_colorspace: display rec2020/rec709}
  rec2020/srgb:
    - !<View> {name: Standard, colorspace: rec2020/srgb}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr-wide, display_colorspace: display rec2020/srgb}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr-wide, display_colorspace: display rec2020/srgb}
  rec2020/linear:
    - !<View> {name: Standard, colorspace: rec2020/linear}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
  rec2020/2.2:
    - !<View> {name: Standard, colorspace: rec2020/2.2}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr-wide, display_colorspace: display rec2020/2.2}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr-wide, display_colorspace: display rec2020/2.2}
  rec2020/2.4:
    - !<View> {name: Standard, colorspace: rec2020/2.4}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr-wide, display_colorspace: display rec2020/2.4}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr-wide, display_colorspace: display rec2020/2.4}
  rec2020/2.6:
    - !<View> {name: Standard, colorspace: rec2020/2.6}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr-wide, display_colorspace: display rec2020/2.6}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr-wide, display_colorspace: display rec2020/2.6}
  rec2020/pq:
    - !<View> {name: Standard, colorspace: rec2020/pq}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 hdr-wide, display_colorspace: display rec2020/pq}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 hdr-wide, display_colorspace: display rec2020/pq}
  rec2020/hlg:
    - !<View> {name: Standard, colorspace: rec2020/hlg}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 hdr-wide, display_colorspace: display rec2020/hlg}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 hdr-wide, display_colorspace: display rec2020/hlg}
  p3/rec709:
    - !<View> {name: Standard, colorspace: p3/rec709}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr-wide, display_colorspace: display p3/rec709}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr-wide, display_colorspace: display p3/rec709}
  p3/srgb:
    - !<View> {name: Standard, colorspace: p3/srgb}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr-wide, display_colorspace: display p3/srgb}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr-wide, display_colorspace: display p3/srgb}
  p3/linear:
    - !<View> {name: Standard, colorspace: p3/linear}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
  p3/2.2:
    - !<View> {name: Standard, colorspace: p3/2.2}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr-wide, display_colorspace: display p3/2.2}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr-wide, display_colorspace: display p3/2.2}
  p3/2.4:
    - !<View> {name: Standard, colorspace: p3/2.4}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr-wide, display_colorspace: display p3/2.4}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr-wide, display_colorspace: display p3/2.4}
  p3/2.6:
    - !<View> {name: Standard, colorspace: p3/2.6}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr-wide, display_colorspace: display p3/2.6}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr-wide, display_colorspace: display p3/2.6}
  p3/pq:
    - !<View> {name: Standard, colorspace: p3/pq}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 hdr, display_colorspace: display p3/pq}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 hdr, display_colorspace: display p3/pq}
  p3/hlg:
    - !<View> {name: Standard, colorspace: p3/hlg}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
  rec601/rec709:
    - !<View> {name: Standard, colorspace: rec601/rec709}
    - !<View> {name: Linear diagnostic, colorspace: rec601/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display rec601/rec709}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display rec601/rec709}
  rec601/srgb:
    - !<View> {name: Standard, colorspace: rec601/srgb}
    - !<View> {name: Linear diagnostic, colorspace: rec601/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display rec601/srgb}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display rec601/srgb}
  rec601/linear:
    - !<View> {name: Standard, colorspace: rec601/linear}
    - !<View> {name: Linear diagnostic, colorspace: rec601/linear}
  rec601/2.2:
    - !<View> {name: Standard, colorspace: rec601/2.2}
    - !<View> {name: Linear diagnostic, colorspace: rec601/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display rec601/2.2}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display rec601/2.2}
  rec601/2.4:
    - !<View> {name: Standard, colorspace: rec601/2.4}
    - !<View> {name: Linear diagnostic, colorspace: rec601/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display rec601/2.4}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display rec601/2.4}
  rec601/2.6:
    - !<View> {name: Standard, colorspace: rec601/2.6}
    - !<View> {name: Linear diagnostic, colorspace: rec601/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 sdr, display_colorspace: display rec601/2.6}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 sdr, display_colorspace: display rec601/2.6}
  rec601/pq:
    - !<View> {name: Standard, colorspace: rec601/pq}
    - !<View> {name: Linear diagnostic, colorspace: rec601/linear}
    - !<View> {name: ACES 2.0, view_transform: ACES 2.0 hdr, display_colorspace: display rec601/pq}
    - !<View> {name: ACES 1.3, view_transform: ACES 1.3 hdr, display_colorspace: display rec601/pq}
  rec601/hlg:
    - !<View> {name: Standard, colorspace: rec601/hlg}
    - !<View> {name: Linear diagnostic, colorspace: rec601/linear}

active_displays: []
active_views: []

default_view_transform: Un-tone-mapped

view_transforms:
  - !<ViewTransform>
    name: Un-tone-mapped
    from_scene_reference: !<MatrixTransform> {matrix: [0.412390799265959, 0.357584339383878, 0.180480788401834, 0, 0.21263900587151, 0.715168678767756, 0.0721923153607337, 0, 0.0193308187155918, 0.119194779794626, 0.950532152249661, 0, 0, 0, 0, 1]}

  - !<ViewTransform>
    name: ACES 2.0 sdr
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Linear Rec.709, dst: ACES2065-1}
        - !<BuiltinTransform> {style: ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - SDR-100nit-REC709_2.0}

  - !<ViewTransform>
    name: ACES 1.3 sdr
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Linear Rec.709, dst: ACES2065-1}
        - !<BuiltinTransform> {style: ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - SDR-VIDEO_1.0}

  - !<ViewTransform>
    name: ACES 2.0 hdr
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Linear Rec.709, dst: ACES2065-1}
        - !<BuiltinTransform> {style: ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - HDR-1000nit-P3-D65_2.0}

  - !<ViewTransform>
    name: ACES 1.3 hdr
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Linear Rec.709, dst: ACES2065-1}
        - !<BuiltinTransform> {style: ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - HDR-VIDEO-1000nit-15nit-P3lim_1.1}

  - !<ViewTransform>
    name: ACES 2.0 sdr-wide
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Linear Rec.709, dst: ACES2065-1}
        - !<BuiltinTransform> {style: ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - SDR-100nit-P3-D65_2.0}

  - !<ViewTransform>
    name: ACES 1.3 sdr-wide
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Linear Rec.709, dst: ACES2065-1}
        - !<BuiltinTransform> {style: ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - SDR-VIDEO-P3lim_1.1}

  - !<ViewTransform>
    name: ACES 2.0 hdr-wide
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Linear Rec.709, dst: ACES2065-1}
        - !<BuiltinTransform> {style: ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - HDR-1000nit-REC2020_2.0}

  - !<ViewTransform>
    name: ACES 1.3 hdr-wide
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Linear Rec.709, dst: ACES2065-1}
        - !<BuiltinTransform> {style: ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - HDR-VIDEO-1000nit-15nit-REC2020lim_1.1}

display_colorspaces:
  - !<ColorSpace>
    name: CIE XYZ D65
    family: ""
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    allocation: uniform

  - !<ColorSpace>
    name: display rec709/rec709
    family: Display
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [3.24096994190452, -1.53738317757009, -0.498610760293004, 0, -0.96924363628088, 1.87596750150772, 0.0415550574071756, 0, 0.0556300796969936, -0.203976958888977, 1.05697151424288, 0, 0, 0, 0, 1]}
        - !<ExponentTransform> {value: 2.4, style: mirror, direction: inverse}

  - !<ColorSpace>
    name: display rec709/srgb
    family: Display
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [3.24096994190452, -1.53738317757009, -0.498610760293004, 0, -0.96924363628088, 1.87596750150772, 0.0415550574071756, 0, 0.0556300796969936, -0.203976958888977, 1.05697151424288, 0, 0, 0, 0, 1]}
        - !<ExponentWithLinearTransform> {gamma: 2.4, offset: 0.055, direction: inverse}

  - !<ColorSpace>
    name: display rec709/2.2
    family: Display
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [3.24096994190452, -1.53738317757009, -0.498610760293004, 0, -0.96924363628088, 1.87596750150772, 0.0415550574071756, 0, 0.0556300796969936, -0.203976958888977, 1.05697151424288, 0, 0, 0, 0, 1]}
        - !<ExponentTransform> {value: 2.2, style: mirror, direction: inverse}

  - !<ColorSpace>
    name: display rec709/2.4
    family: Display
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [3.24096994190452, -1.53738317757009, -0.498610760293004, 0, -0.96924363628088, 1.87596750150772, 0.0415550574071756, 0, 0.0556300796969936, -0.203976958888977, 1.05697151424288, 0, 0, 0, 0, 1]}
        - !<ExponentTransform> {value: 2.4, style: mirror, direction: inverse}

  - !<ColorSpace>
    name: display rec709/2.6
    family: Display
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [3.24096994190452, -1.53738317757009, -0.498610760293004, 0, -0.96924363628088, 1.87596750150772, 0.0415550574071756, 0, 0.0556300796969936, -0.203976958888977, 1.05697151424288, 0, 0, 0, 0, 1]}
        - !<ExponentTransform> {value: 2.6, style: mirror, direction: inverse}

  - !<ColorSpace>
    name: display rec709/pq
    family: Display
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: hdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [3.24096994190452, -1.53738317757009, -0.498610760293004, 0, -0.96924363628088, 1.87596750150772, 0.0415550574071756, 0, 0.0556300796969936, -0.203976958888977, 1.05697151424288, 0, 0, 0, 0, 1]}
        - !<FixedFunctionTransform> {style: Lin_TO_PQ}

  - !<ColorSpace>
    name: display srgb/rec709
    family: Display
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [3.24096994190452, -1.53738317757009, -0.498610760293004, 0, -0.96924363628088, 1.87596750150772, 0.0415550574071756, 0, 0.0556300796969936, -0.203976958888977, 1.05697151424288, 0, 0, 0, 0, 1]}
        - !<ExponentTransform> {value: 2.4, style: mirror, direction: inverse}

  - !<ColorSpace>
    name: display srgb/srgb
    family: Display
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [3.24096994190452, -1.53738317757009, -0.498610760293004, 0, -0.96924363628088, 1.87596750150772, 0.0415550574071756, 0, 0.0556300796969936, -0.203976958888977, 1.05697151424288, 0, 0, 0, 0, 1]}
        - !<ExponentWithLinearTransform> {gamma: 2.4, offset: 0.055, direction: inverse}

  - !<ColorSpace>
    name: display srgb/2.2
    family: Display
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: sdr-video
    allocation: uniform
