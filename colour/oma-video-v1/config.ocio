    - !<View> {name: Standard, colorspace: p3/2.2}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
  p3/2.4:
    - !<View> {name: Standard, colorspace: p3/2.4}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
  p3/2.6:
    - !<View> {name: Standard, colorspace: p3/2.6}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
