    - !<View> {name: Standard, colorspace: p3/pq}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
  p3/hlg:
    - !<View> {name: Standard, colorspace: p3/hlg}
    - !<View> {name: Linear diagnostic, colorspace: p3/linear}
