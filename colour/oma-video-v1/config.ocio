ocio_profile_version: 2.4

environment:
  {}
search_path: ""
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]
name: Oma Colour 1 - Video 1
description: Oma suite linear Rec.709 D65 interchange. Video component encodings; no tone mapping. PQ linear 1 = 100 cd/m2, preserving highlights above 1. HLG uses normalized inverse OETF, without display OOTF. MLT compositing/storage have integer boundaries.

roles:
  aces_interchange: ACES2065-1
  cie_xyz_d65_interchange: CIE XYZ D65
  color_picking: sRGB
  color_timing: rec709/rec709
  compositing_log: Log2 Rec.709
  data: Raw
  default: sRGB
  matte_paint: sRGB
  oma_interchange: Linear Rec.709
  scene_linear: Linear Rec.709
  texture_paint: sRGB

file_rules:
  - !<Rule> {name: Default, colorspace: sRGB}

displays:
  sRGB:
    - !<View> {name: Standard, colorspace: sRGB}
    - !<View> {name: Linear diagnostic, colorspace: Linear Rec.709}
  rec709/rec709:
    - !<View> {name: Standard, colorspace: rec709/rec709}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
  rec709/srgb:
    - !<View> {name: Standard, colorspace: rec709/srgb}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
  rec709/linear:
    - !<View> {name: Standard, colorspace: rec709/linear}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
  rec709/2.2:
    - !<View> {name: Standard, colorspace: rec709/2.2}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
  rec709/2.4:
    - !<View> {name: Standard, colorspace: rec709/2.4}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
  rec709/2.6:
    - !<View> {name: Standard, colorspace: rec709/2.6}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
  rec709/pq:
    - !<View> {name: Standard, colorspace: rec709/pq}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
  rec709/hlg:
    - !<View> {name: Standard, colorspace: rec709/hlg}
    - !<View> {name: Linear diagnostic, colorspace: rec709/linear}
  srgb/rec709:
    - !<View> {name: Standard, colorspace: srgb/rec709}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
  srgb/srgb:
    - !<View> {name: Standard, colorspace: srgb/srgb}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
  srgb/linear:
    - !<View> {name: Standard, colorspace: srgb/linear}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
  srgb/2.2:
    - !<View> {name: Standard, colorspace: srgb/2.2}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
  srgb/2.4:
    - !<View> {name: Standard, colorspace: srgb/2.4}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
  srgb/2.6:
    - !<View> {name: Standard, colorspace: srgb/2.6}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
  srgb/pq:
    - !<View> {name: Standard, colorspace: srgb/pq}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
  srgb/hlg:
    - !<View> {name: Standard, colorspace: srgb/hlg}
    - !<View> {name: Linear diagnostic, colorspace: srgb/linear}
  rec2020/rec709:
    - !<View> {name: Standard, colorspace: rec2020/rec709}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
  rec2020/srgb:
    - !<View> {name: Standard, colorspace: rec2020/srgb}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
  rec2020/linear:
    - !<View> {name: Standard, colorspace: rec2020/linear}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
  rec2020/2.2:
    - !<View> {name: Standard, colorspace: rec2020/2.2}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
  rec2020/2.4:
    - !<View> {name: Standard, colorspace: rec2020/2.4}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
  rec2020/2.6:
    - !<View> {name: Standard, colorspace: rec2020/2.6}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
  rec2020/pq:
    - !<View> {name: Standard, colorspace: rec2020/pq}
    - !<View> {name: Linear diagnostic, colorspace: rec2020/linear}
  rec2020/hlg:
