#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PKGBUILD_DIR="$ROOT/pkgbuild"

if ! command -v makepkg >/dev/null 2>&1; then
  echo "makepkg is required to build and install the Arch package." >&2
  exit 1
fi

# NOT built here first: makepkg -s installs the missing build and runtime
# dependencies, and the PKGBUILD's own build() then runs bin/build. Building
# before that point fails on a machine that has no Qt development packages
# yet — which is exactly the machine this script is for.
cd "$PKGBUILD_DIR"
exec makepkg -fsi "$@"
