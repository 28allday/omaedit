#!/usr/bin/env python3
"""Regenerate src/resources.qrc from what is actually on disk.

The UI is a QML module of many small files that grows every phase; listing
them by hand guarantees the one you forget is the one that fails at runtime,
and a missing file shows up only as an unhelpful "type unavailable".
Run this after adding or removing any QML file or script. With --check it
changes nothing and fails when the list has fallen behind.
"""
import glob
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)

out = ['<RCC>', '    <qresource prefix="/">',
       '        <file alias="Main.qml">Main.qml</file>',
       '    </qresource>']

# Every QML module directory under src/qml, keyed by its resource prefix.
for qmldir in sorted(glob.glob('src/qml/**/qmldir', recursive=True)):
    rel = os.path.dirname(qmldir)[len('src/'):]        # qml/OmaEdit/Ui
    out.append(f'    <qresource prefix="/{rel}">')
    out.append(f'        <file alias="qmldir">{rel}/qmldir</file>')
    # The module's QML and the scripts it imports (import "X.js" as X).
    folder = os.path.dirname(qmldir)
    for path in sorted(glob.glob(os.path.join(folder, '*.qml')) + glob.glob(os.path.join(folder, '*.js'))):
        name = os.path.basename(path)
        out.append(f'        <file alias="{name}">{rel}/{name}</file>')
    out.append('    </qresource>')

out.append('</RCC>')
text = '\n'.join(out) + '\n'

if '--check' in sys.argv:
    current = open('src/resources.qrc').read()
    if current != text:
        sys.exit('src/resources.qrc is stale — run ./bin/gen-qrc')
    print('src/resources.qrc is up to date')
else:
    open('src/resources.qrc', 'w').write(text)
    print(f'wrote src/resources.qrc ({text.count("<file")} files)')
