#!/usr/bin/env sh
set -eu

# What pacman and ldd print is read below, whatever language the computer speaks.
export LC_ALL=C

# OmaEdit carries its own FFmpeg, for the patch that lets a laptop's NVIDIA card
# sleep, which the system's has not, and so that the Vulkan encoders it uses (APV
# among them, new in 9.1) are the ones it was tested with whatever FFmpeg the
# system moves on to. This builds it from a pinned commit, for OmaEdit alone, into
# /usr/lib/omaedit/ffmpeg, where the program looks first. Everything else on the
# computer keeps the system FFmpeg.
#
# It holds only what the program uses, and the libraries whose names change when
# the system updates them (x264, x265, SVT-AV1, libvpx, dav1d) travel beside it,
# so an update of those cannot stop it starting. What it links from the system
# stays there (Opus, LAME, Vorbis, Snappy, libva, libdrm, Vulkan's loader, zlib…):
# their names have not changed in years, and the package's depends name them.

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
# Build tools unpacked beside the build (nasm, NVENC headers) when they are not
# installed: a machine without them can still build without root.
TOOLS="$ROOT/build/tools/root/usr"
if [ -d "$TOOLS" ]; then
  PATH="$TOOLS/bin:$PATH"
  PKG_CONFIG_PATH="$TOOLS/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
  CPATH="$TOOLS/include${CPATH:+:$CPATH}"
  export PATH PKG_CONFIG_PATH CPATH
fi
SRC="$ROOT/build/ffmpeg-src"
OUT="$ROOT/build/ffmpeg"          # staged as $OUT$PREFIX
PREFIX=/usr/lib/omaedit/ffmpeg
URL=https://github.com/FFmpeg/FFmpeg.git
COMMIT=74e4393595cf2b5857f0da925c4e0dd74ea306e5   # tag n9.1, the 9.1 release, 2026-11-19
# The patches in pkgbuild/ffmpeg, in order. 0001: no VK_NV_optical_flow unless
# asked for, since NVIDIA's driver starts CUDA for it, which keeps a laptop's
# discrete GPU awake after the work has moved off it.

# Exactly these, whatever else the computer building it has installed.
# The program reads and writes files; it opens no device and no network address,
# draws no text and scales no picture through FFmpeg's filters (its one filter
# is lut3d), so none of the libraries for those is here. The decoders FFmpeg has
# of its own (AAC, MP3, Vorbis, Opus, Theora, VP8, VP9, JPEG 2000, WebP, ProRes,
# DNxHD, MPEG-2 and the rest) need no library. Encoders that do: x264, x265,
# SVT-AV1 and libvpx for the pictures, Opus, LAME and Vorbis for the sound.
# dav1d decodes AV1 where no graphics card does. Snappy is for HAP.
# Hardware decoders and encoders are used wherever a machine has them: Vulkan
# Video first, then each card's own interface (VA-API, NVDEC/NVENC, AMF).
# NVIDIA's and AMD's are loaded from their drivers at run time, so they add no
# dependency. libavdevice is built, empty, because Qt Multimedia's FFmpeg plug-in
# asks for it by name and must get this build's, not the system's beside it.
FLAGS="--prefix=$PREFIX --disable-debug --disable-static --enable-shared
  --disable-programs --disable-doc --disable-autodetect --disable-indevs --disable-outdevs
  --enable-gpl --enable-version3 --enable-bzlib --enable-iconv --enable-lzma --enable-zlib
  --enable-libdav1d --enable-libmp3lame --enable-libopus --enable-libsnappy --enable-libsvtav1
  --enable-libvorbis --enable-libvpx --enable-libx264 --enable-libx265
  --enable-amf --enable-cuvid --enable-ffnvcodec --enable-nvdec --enable-nvenc
  --enable-libdrm --enable-vaapi --enable-vulkan --disable-decoder=magicyuv"
# Travels beside it: "file name start=package".
CARRIED="libx264=x264 libx265=x265 libSvtAv1Enc=svt-av1 libvpx=libvpx libdav1d=dav1d"
carried_versions() {
  for entry in $CARRIED; do pacman -Q "${entry#*=}"; done
}
LIB="$OUT$PREFIX/lib"

# What travels with the libraries, for their licences: what they were built
# from and how. Arch's recipes name the libraries' source; they do not hold it.
SOURCE_TEXT="FFmpeg for OmaEdit, built from:
repository $URL
commit $COMMIT
patched with:
$(for f in "$ROOT"/pkgbuild/ffmpeg/*.patch; do basename "$f"; done)
configured with:
$FLAGS
carrying, as Arch Linux packaged them (build recipes: https://gitlab.archlinux.org/archlinux/packaging/packages/<name>):
$(carried_versions)"
# How a finished build is known: all of that, the patches' and this script's own
# text, and nothing it links gone from the system under a new name.
STAMP_TEXT="$SOURCE_TEXT
$(cat "$ROOT/bin/build-ffmpeg" "$ROOT"/pkgbuild/ffmpeg/*.patch | sha256sum)"
if [ "$(cat "$OUT/STAMP" 2>/dev/null)" = "$STAMP_TEXT" ] && ! ldd "$LIB"/lib*.so.* | grep -q 'not found'; then
  exit 0
fi

echo "Building FFmpeg 9.1 for OmaEdit…"
rm -rf "$OUT"
mkdir -p "$SRC"
cd "$SRC"
[ -d .git ] || git init -q
git fetch -q --depth=1 "$URL" "$COMMIT"
git -c advice.detachedHead=false checkout -q --force FETCH_HEAD
# A clean tree: make does not notice changed flags, and an earlier build's
# objects (with other flags) would be linked as they are.
git clean -fdxq
for f in "$ROOT"/pkgbuild/ffmpeg/*.patch; do git apply "$f"; done

# shellcheck disable=SC2086
./configure $FLAGS
# Each library's own run path, so it finds what travels beside it: the linker
# takes this as written, where FFmpeg's flags pass through make and the shell.
LD_RUN_PATH='$ORIGIN' make -j"${OMAEDIT_BUILD_JOBS:-$(nproc 2>/dev/null || echo 1)}"
make install DESTDIR="$OUT"

# Building against the staged copy: its pkg-config files name the install
# place outright (prefix, libdir, includedir), so all of them move to the stage.
sed -i "s|$PREFIX|$OUT$PREFIX|g" "$OUT$PREFIX"/lib/pkgconfig/*.pc

# The libraries that travel beside it, under the names FFmpeg was linked to, and
# their licences (the common ones live in Arch's shared licence folder).
for entry in $CARRIED; do
  file=$(ldd "$LIB"/libavcodec.so.* | awk -v name="${entry%=*}.so" 'index($1, name) == 1 { print $1, $3; exit }')
  [ -n "$file" ] || { echo "FFmpeg did not link ${entry%=*}" >&2; exit 1; }
  cp -L "${file#* }" "$LIB/${file%% *}"
  package=${entry#*=}
  mkdir -p "$OUT/licenses/$package"
  if [ -d "/usr/share/licenses/$package" ]; then
    cp -L "/usr/share/licenses/$package"/* "$OUT/licenses/$package/"
  else
    licences=$(pacman -Qi "$package" | sed -n 's/^Licenses *: //p')
    # Arch tags x264 by its COPYING file. Its source says "or any later version"
    # (x264.h), which is how it comes into an FFmpeg built GPL v3.
    if [ "$package" = x264 ]; then licences=GPL-2.0-or-later; fi
    for licence in $licences; do
      case "$licence" in AND|OR|WITH) continue ;; esac
      cp -L "/usr/share/licenses/spdx/$licence.txt" "$OUT/licenses/$package/"
    done
  fi
done

printf '%s\n' "$SOURCE_TEXT" > "$OUT/SOURCE"
printf '%s\n' "$STAMP_TEXT" > "$OUT/STAMP"
echo "Built FFmpeg 9.1 into $OUT$PREFIX"
