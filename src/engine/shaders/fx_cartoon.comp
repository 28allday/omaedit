#version 450
#extension GL_GOOGLE_include_directive : require
// Cartoon: colours flattened to a few steps, with dark outlines where the
// brightness changes by more than value 0's share; value 1 sets how many
// steps (0 few, 1 many).
#include "fx_common.glsl"
float l(ivec2 q) { return lumaOf(display(at(q).rgb)); }
vec4 effect(ivec2 p) {
    float gx = l(p + ivec2(1, -1)) + 2.0 * l(p + ivec2(1, 0)) + l(p + ivec2(1, 1)) - l(p + ivec2(-1, -1)) - 2.0 * l(p + ivec2(-1, 0)) - l(p + ivec2(-1, 1));
    float gy = l(p + ivec2(-1, 1)) + 2.0 * l(p + ivec2(0, 1)) + l(p + ivec2(1, 1)) - l(p + ivec2(-1, -1)) - 2.0 * l(p + ivec2(0, -1)) - l(p + ivec2(1, -1));
    float m = sqrt(gx * gx + gy * gy) * 0.25 * unit();
    vec4 c = at(p);
    float n = 3.0 + floor(clamp(P(1), 0.0, 1.0) * 12.0 + 0.5);
    vec3 e = floor(display(c.rgb) * n + 0.5) / n;
    if (m > max(0.02, P(0) * 0.4)) e = vec3(0.0);
    return vec4(light(e), c.a);
}
