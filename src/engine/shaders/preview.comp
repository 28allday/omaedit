#version 450
// Canvas -> sRGB BGRA8 at the preview size, bilinear.
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) uniform sampler2D canvas;
layout(binding = 1, std430) buffer Out { uint data[]; } outBuf;
// encoded: 1 already display R'G'B'; 2 the same with colour multiplied by its alpha (a viewer's picture)
layout(push_constant) uniform Push { ivec2 outSize; int encoded; } pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.outSize.x || p.y >= pc.outSize.y) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(pc.outSize);
    // Straight colour with its alpha: the canvas is solid; a keyed source shows where it is clear.
    vec4 s = straightSample(alphaBilinear(canvas, uv));
    vec3 c = pc.encoded != 0 ? clamp(s.rgb, 0.0, 1.0) : linearToSrgb(s.rgb);
    if (pc.encoded == 2) c *= clamp(s.a, 0.0, 1.0);
    c *= 255.0;
    uint packed = to8(c.b) | (to8(c.g) << 8) | (to8(c.r) << 16) | (to8(s.a * 255.0) << 24);
    outBuf.data[p.y * pc.outSize.x + p.x] = packed;
}
