#version 450
#extension GL_GOOGLE_include_directive : require
// Emboss: grey relief lit from one side. Value 0: the light's direction
// (a full turn at 1), 1: its height (overhead at 1), 2: depth.
#include "fx_common.glsl"
float l(ivec2 q) { return lumaOf(display(at(q).rgb)); }
vec4 effect(ivec2 p) {
    float gx = l(p + ivec2(1, 0)) - l(p - ivec2(1, 0)), gy = l(p + ivec2(0, 1)) - l(p - ivec2(0, 1));
    float az = P(0) * 6.28318531, el = clamp(P(1), 0.0, 1.0) * 1.57079633;
    vec3 n = normalize(vec3(-gx * P(2) * 8.0 * unit(), -gy * P(2) * 8.0 * unit(), 1.0));
    vec3 ld = vec3(cos(el) * cos(az), cos(el) * sin(az), sin(el));
    float v = clamp(0.5 + dot(n, ld) - ld.z, 0.0, 1.0);
    return vec4(light(vec3(v)), at(p).a);
}
