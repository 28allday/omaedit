#version 450
#extension GL_GOOGLE_include_directive : require
// Glitch: bands of rows (value 1: their height, a tenth of the picture at 1)
// that on some frames (value 0: how many) slide across by up to value 2 of
// a fifth of the width; value 3: how many of those also swap red and blue.
#include "fx_common.glsl"
vec4 effect(ivec2 p) {
    // Bands counted on the picture this one stands for, so a smaller
    // drawing moves the same rows.
    int band = max(2, int(P(1) * 0.1 * float(pc.size.y) / unit() + 0.5));
    int b = int((float(p.y) + 0.5) / unit()) / band;
    vec2 q = vec2(p) + 0.5;
    bool moved = fxHash(b, pc.frame, 29) < P(0);
    if (moved) q.x += (fxHash(b, pc.frame, 31) * 2.0 - 1.0) * P(2) * 0.2 * float(pc.size.x);
    q.x = q.x - floor(q.x / float(pc.size.x)) * float(pc.size.x);
    vec4 c = sampleAt(q);
    if (moved && fxHash(b, pc.frame, 37) < P(3)) c.rgb = c.bgr;
    return c;
}
